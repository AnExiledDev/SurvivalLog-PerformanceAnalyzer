<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The pure core is compiled straight in, so the tests need none of the game or BepInEx assemblies. -->
  <ItemGroup>
    <Compile Include="..\..\src\PerformanceAnalyzer\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\markers\PerfMarkers.cs" Link="markers\PerfMarkers.cs" />
  </ItemGroup>

  <!-- The page scripts as the plugin ships them, run in Jint. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\PerformanceAnalyzer\web\*" LogicalName="PerformanceAnalyzer.web.%(Filename)%(Extension)" Link="web\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
