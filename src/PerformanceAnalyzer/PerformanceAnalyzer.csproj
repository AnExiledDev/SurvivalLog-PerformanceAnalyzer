<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>PerformanceAnalyzer</AssemblyName>
    <RootNamespace>PerformanceAnalyzer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Survival Log</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\SemanticVersioning.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\HotUpdate.dll" Private="false" />
    <Reference Include="$(Interop)\AOT.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\Vuplex.WebView.dll" Private="false" />
    <Reference Include="$(ToolkitDll)" Private="false" />
  </ItemGroup>

  <!-- The web probe, and the panel in the order PageBundle joins it. -->
  <ItemGroup>
    <EmbeddedResource Include="web\*" LogicalName="PerformanceAnalyzer.web.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- What the Mod Manager's Mods screen shows about this mod. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModManager.Name" Value="Performance Analyzer&#10;性能分析器" />
    <AssemblyMetadata Include="ModManager.Description" Value="A testing tool that finds out what makes the game slow. It times other mods' hooks and update methods, the game code inside hooked methods and the scripts each mod runs in the menus. It also keeps every frame that stutters, with what ran in it. Press Insert (the default key) to open the panel. Copy report puts a text report on the clipboard.&#10;一个查找游戏卡顿来源的测试工具。它统计其他模组的钩子与更新方法、被钩住的游戏代码，以及各模组在菜单中运行的脚本所用的时间，还会记下每一个卡顿帧以及其中运行的内容。按 Insert（默认按键）打开面板。「Copy report」会把一份文字报告复制到剪贴板。" />
    <AssemblyMetadata Include="ModManager.Author" Value="AnExiledDev" />
    <AssemblyMetadata Include="ModManager.Category" Value="Tools" />
    <AssemblyMetadata Include="ModManager.GameVersion" Value="1.1.20719" />
    <AssemblyMetadata Include="ModManager.Settings" Value="Live" />
    <AssemblyMetadata Include="ModManager.GitHub" Value="AnExiledDev/SurvivalLog-PerformanceAnalyzer" />
    <AssemblyMetadata Include="ModManager.Changelog" Value="https://github.com/AnExiledDev/SurvivalLog-PerformanceAnalyzer/blob/main/CHANGELOG.md" />
  </ItemGroup>

</Project>
